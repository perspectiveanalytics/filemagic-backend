/* Strict allowlist for libvips + ImageMagick fallback (BMP) — deny everything except what's needed */
POLICY image_strict {
  ERRNO(38) {  /* ENOSYS */
    clone3
  },
  ALLOW {
    /* Essential I/O */
    read, write, pread64, pwrite64, readv, writev,
    open, openat, openat2, close, lseek,

    /* Stat operations */
    newstat, newfstat, newlstat, newfstatat, statx,

    /* Memory management (vips is memory-intensive) */
    mmap, munmap, mremap, mprotect, madvise, brk,

    /* Process lifecycle */
    execve,
    /* clone: deny CLONE_NEWUSER|NEWNS|NEWNET|NEWPID|NEWUTS|NEWIPC|NEWCGROUP */
    clone(cflags) { (cflags & 0x7e020000) == 0 },
    exit, exit_group, wait4, waitid,

    /* Signal handling */
    rt_sigaction, rt_sigprocmask, rt_sigreturn, sigaltstack,
    tgkill, tkill, rt_sigsuspend,

    /* File operations */
    access, faccessat, faccessat2, getcwd, chdir, fchdir,
    dup, dup2, dup3, fcntl, ioctl, pipe, pipe2,
    unlink, unlinkat,
    rename, renameat, renameat2,
    ftruncate, fchmod, fchmodat,

    /* Directory operations */
    mkdir, mkdirat, getdents, getdents64,

    /* Essential system info */
    getuid, getgid, geteuid, getegid, getpid, getppid, gettid,
    getrlimit, prlimit64, newuname, arch_prctl, set_tid_address,
    prctl, capget,

    /* Time operations */
    clock_gettime, clock_getres, gettimeofday, nanosleep, clock_nanosleep,
    times,

    /* Futex for threading (vips uses threads heavily) */
    futex, set_robust_list, get_robust_list,

    /* File metadata */
    readlink, readlinkat, lgetxattr, fgetxattr,

    /* Shared memory for image processing */
    shmget, shmat, shmdt, shmctl,

    /* Filesystem info */
    statfs, fstatfs,

    /* Polling/select */
    poll, ppoll, select, pselect6,

    /* Misc */
    getrandom, umask, sched_yield, sched_getaffinity, rseq, sysinfo,

    /* ImageMagick/OpenMP thread management (used via vips magickload for BMP) */
    sched_setaffinity,

    /* Socket info (glib probes fd type via getpeername) */
    getpeername
  }
}
USE image_strict DEFAULT KILL
