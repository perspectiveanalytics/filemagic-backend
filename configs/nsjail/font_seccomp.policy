/* Strict allowlist for Python3 + fonttools font conversion */
POLICY font_strict {
  ALLOW {
    /* Essential I/O */
    read, write, pread64, pwrite64, readv, writev,
    openat, close, lseek,

    /* Stat operations */
    newfstat, newfstatat, statx,

    /* Memory management */
    mmap, munmap, mremap, mprotect, madvise, brk,

    /* Process lifecycle */
    execve, exit_group,

    /* Signal handling */
    rt_sigaction, rt_sigprocmask, rt_sigreturn, sigaltstack,

    /* File operations */
    access, faccessat, faccessat2, getcwd,
    dup, dup2, fcntl, ioctl,
    unlink, unlinkat,
    close_range,
    rename, renameat, renameat2,
    umask,

    /* Directory operations */
    getdents64,

    /* Essential system info */
    getuid, getgid, geteuid, getegid, getpid, gettid,
    prlimit64, arch_prctl, set_tid_address,
    prctl, capget,

    /* Time operations */
    clock_gettime, clock_getres, gettimeofday, nanosleep,

    /* Futex for threading */
    futex, set_robust_list, get_robust_list,

    /* File metadata */
    readlink, readlinkat,

    /* Polling (Python selectors module) */
    epoll_create1, epoll_ctl, epoll_wait, epoll_pwait,

    /* Misc */
    getrandom, rseq, sched_getaffinity, sched_yield
  }
}
USE font_strict DEFAULT KILL
