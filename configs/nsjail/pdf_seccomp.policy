/* Strict allowlist for Ghostscript - deny everything except what's needed */
POLICY pdf_strict {
  ERRNO(38) {  /* ENOSYS */
    clone3
  },
  ALLOW {
    /* Essential I/O */
    read, write, pread64, pwrite64, readv, writev,
    open, openat, openat2, close, lseek,

    /* Stat operations */
    newstat, newfstat, newlstat, newfstatat, statx,

    /* Memory management */
    mmap, munmap, mremap, mprotect, madvise, brk,

    /* Process lifecycle */
    fork, vfork, execve,
    /* clone: deny CLONE_NEWUSER|NEWNS|NEWNET|NEWPID|NEWUTS|NEWIPC|NEWCGROUP */
    clone(cflags) { (cflags & 0x7e020000) == 0 },
    exit, exit_group, wait4, waitid,

    /* Signal handling */
    rt_sigaction, rt_sigprocmask, rt_sigreturn, sigaltstack,
    tgkill, tkill, rt_sigsuspend, rt_sigpending,

    /* File operations */
    access, faccessat, faccessat2, getcwd, chdir, fchdir,
    dup, dup2, dup3, fcntl, ioctl, pipe, pipe2,
    unlink, unlinkat, rename, renameat, renameat2,
    link, linkat,
    ftruncate, fchmod, fchmodat, chmod,

    /* Filesystem info */
    statfs, fstatfs,

    /* Directory operations */
    mkdir, mkdirat, rmdir, getdents, getdents64,

    /* Essential system info */
    getuid, getgid, geteuid, getegid, getpid, getppid, gettid,
    getrlimit, prlimit64, newuname, arch_prctl, set_tid_address,
    prctl, capget,

    /* Time operations */
    clock_gettime, clock_getres, gettimeofday, nanosleep, clock_nanosleep,

    /* Futex for threading */
    futex, set_robust_list, get_robust_list,

    /* File metadata */
    readlink, readlinkat, lgetxattr, fgetxattr,

    /* Polling/select */
    poll, ppoll, select, pselect6, epoll_create, epoll_create1,
    epoll_ctl, epoll_wait, epoll_pwait,

    /* Misc */
    getrandom, umask, sched_yield, sched_getaffinity, rseq, sysinfo, times,

    /* Socket info (glib probes fd type) */
    getpeername
  }
}
USE pdf_strict DEFAULT KILL
